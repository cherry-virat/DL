# Environment Configuration Template
# Copy this file to .env and provide deployment-specific values.
# NEVER commit the actual .env file or real secrets to Git.

# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=replace_with_a_secure_random_hex_string_64_chars
PORT=5000
HOST=0.0.0.0

# Hardware & Compute Runtime
# Options: cpu | cuda
TORCH_DEVICE=cpu

# Storage Locations
API_RUNS_DIR=outputs/api_runs
UPLOADS_MAX_CONTENT_LENGTH_MB=250

# Model Checkpoints (Leave blank or adjust if weights are located in default outputs/ directories)
GLIOMA_CHECKPOINT_PATH=outputs/glioma_training/glioma_best_medium_experiment.pth
MENINGIOMA_CHECKPOINT_PATH=outputs/meningioma_best.pth
STAGE1_PRESENCE_CHECKPOINT=outputs/classifier_stage1/best_model.pth
STAGE2_PATHOLOGY_CHECKPOINT=outputs/classifier_stage2/best_model.pth

# Remote Cloud Checkpoint Hydration (Optional: S3 / GCS / Hugging Face bucket)
# CHECKPOINT_STORAGE_BUCKET_URL=https://storage.googleapis.com/your-mri-model-bucket/checkpoints
